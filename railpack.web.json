{
  "$schema": "https://schema.railpack.com",
  "buildAptPackages": [
    "python3",
    "python3-pip",
    "python3-venv",
    "build-essential",
    "git",
    "curl",
    "xz-utils"
  ],
  "steps": {
    "build": {
      "commands": ["bash scripts/railway-build-web.sh"]
    }
  },
  "deploy": {
    "startCommand": "pnpm start:web",
    "inputs": [
      "...",
      {
        "step": "build",
        "include": ["apps/web/.output"]
      }
    ]
  }
}
