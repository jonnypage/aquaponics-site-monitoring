VITE_PUBLIC_API_URL=http://localhost:4000
# Optional: LAN URL for device installer only (ESP8266 apiOrigin). Keep VITE_PUBLIC_API_URL on localhost for login cookies.
# VITE_DEVICE_API_ORIGIN=http://192.168.1.106:4000
# Optional: browser key for @react-google-maps/api (site detail map + admin location picker).
# Enable "Maps JavaScript API" in Google Cloud and restrict the key to your dev/production HTTP referrers.
# VITE_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
