# Copy to `.env` at repo root for local tooling, or set equivalent variables on Railway.
#
# --- Railway: API service (and one-off migrate/seed using same env) ---
#
# DATABASE_PUBLIC_URL
#   Use the public Postgres URL (Railway exposes this for connections outside the private network).
#   In Railway UI: New Variable → Variable Reference → Postgres → DATABASE_PUBLIC_URL
#   (Use this project-wide so local tooling and deploys share one name; internal `DATABASE_URL`
#   is still fine for private networking if you later split services and point the API at it.)
#
# AUTH_SECRET
#   Generate locally: openssl rand -hex 32
#   Must be stable across deploys or all sessions invalidate.
#
# WEB_ORIGIN
#   Exact browser origin of your web app, e.g. https://your-web.up.railway.app
#   No trailing slash. CORS in production allows only this origin.
#
# NODE_ENV
#   Set to `production` on Railway so cookies use Secure and CORS uses WEB_ORIGIN.
#
# PORT
#   Railway sets this automatically; omit or leave unset unless you override.
#
# PG_POOL_MAX
#   Use a small pool on the API (e.g. 3) per handoff; optional for migrate/seed.

NODE_ENV=production
DATABASE_PUBLIC_URL=
AUTH_SECRET=
WEB_ORIGIN=
PORT=
PG_POOL_MAX=3

# --- Seed (run locally or Railway one-off: pnpm seed with env loaded) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-after-first-login
SEED_ADMIN_NAME=Admin
SEED_VIEWER_EMAIL=viewer@example.com
SEED_VIEWER_PASSWORD=change-me-viewer
SEED_VIEWER_NAME=Viewer
SEED_SITE_NAME=Demo Site
