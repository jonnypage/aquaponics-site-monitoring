{
  "name": "@aquaponics/db",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate:dev": "tsx src/scripts/migrate.ts latest",
    "migrate:deploy": "tsx src/scripts/migrate.ts latest",
    "migrate:down": "tsx src/scripts/migrate.ts down",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "dotenv": "16.6.1",
    "kysely": "0.28.8",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.0.10",
    "@types/pg": "8.15.5",
    "tsx": "4.20.5",
    "typescript": "5.8.3"
  }
}
