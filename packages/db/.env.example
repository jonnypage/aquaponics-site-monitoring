# Local dev. For Railway, point DATABASE_PUBLIC_URL at the same Postgres as the API (reference or copy).

DATABASE_PUBLIC_URL=postgres://postgres:postgres@localhost:5432/aquaponics
PG_POOL_MAX=10
NODE_ENV=development
SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_PASSWORD=changeme-admin
SEED_ADMIN_NAME=Seed Admin
SEED_VIEWER_EMAIL=viewer@local.dev
SEED_VIEWER_PASSWORD=changeme-viewer
SEED_VIEWER_NAME=Seed Viewer
SEED_SITE_NAME=Demo Site
SEED_DEVICE_ID=seed-device-1
SEED_DEVICE_API_KEY=local-dev-ingest-key-change-in-prod-32chars
