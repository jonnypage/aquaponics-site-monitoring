{
  "name": "aquaponics-site-monitoring",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm build:api",
    "start": "pnpm start:api",
    "build:api": "pnpm --filter @aquaponics/db build && pnpm --filter @aquaponics/api build",
    "start:api": "pnpm --filter @aquaponics/api start",
    "dev:api": "pnpm --filter @aquaponics/db build && pnpm --filter @aquaponics/api dev",
    "firmware:build": "node scripts/build-firmware.mjs",
    "firmware:monitor": "node scripts/firmware-monitor.mjs",
    "firmware:placeholder": "node scripts/generate-firmware-placeholder.mjs",
    "firmware:ensure": "node scripts/ensure-firmware-binary.mjs",
    "firmware:copy": "node scripts/copy-firmware-build.mjs",
    "predev:web": "node scripts/ensure-or-build-firmware.mjs",
    "prebuild:web": "node scripts/ensure-or-build-firmware.mjs",
    "dev:web": "pnpm --filter @aquaponics/web dev",
    "build:web": "pnpm --filter @aquaponics/web build",
    "build:api:railway": "bash scripts/railway-build-api.sh",
    "build:web:railway": "bash scripts/railway-build-web.sh",
    "start:web": "pnpm --filter @aquaponics/web start",
    "typecheck": "pnpm -r typecheck",
    "migrate:deploy": "pnpm --filter @aquaponics/db migrate:deploy",
    "migrate:dev": "pnpm --filter @aquaponics/db migrate:dev",
    "seed": "pnpm --filter @aquaponics/db seed",
    "db:setup": "pnpm migrate:deploy && pnpm seed"
  }
}
